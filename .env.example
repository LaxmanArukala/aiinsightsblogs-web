# Copy to .env.development and .env.production, then fill in per environment.
# Both files are gitignored, but the deploy rsync does copy .env.production to the
# EC2 box, and Next.js loads it automatically during `npm run build`.
#
# Every NEXT_PUBLIC_* value is inlined at BUILD time, not read at runtime, so the
# file must exist on the server before you build or the tags below will not render.
#
# NOTE: every NEXT_PUBLIC_* value is inlined into the client bundle and is publicly
# readable by design. None of these are secrets. Never put a real secret here.

# Backend API origin.
NEXT_PUBLIC_API_BASE_URL=https://api.aiinsightsblogs.com

# Google Analytics 4 measurement ID. Leave blank to disable (recommended in dev,
# so local browsing does not pollute the production property).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager container ID. Leave blank to disable.
NEXT_PUBLIC_GTM_ID=

# AdSense publisher ID, e.g. ca-pub-XXXXXXXXXXXXXXXX. Must match public/ads.txt.
NEXT_PUBLIC_ADSENSE_ID=

# Bing Webmaster Tools verification token (the msvalidate.01 meta value).
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# AdSense ad-unit id for the blog sidebar placement (from the AdSense dashboard).
# Empty = the slot renders nothing in production.
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
